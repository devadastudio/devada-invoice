# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Devada Leads (Prospection B2B & Scraping)
# Token Apify personnel pour le crawler Google Maps (https://console.apify.com)
APIFY_TOKEN=

# Devada Leads (Génération de Messages IA)
# Clé API OpenAI (https://platform.openai.com)
OPENAI_API_KEY=
# Modèle OpenAI recommandé : gpt-4o-mini ou gpt-5.6-luna
OPENAI_MODEL=gpt-4o-mini

# Limites de sécurité par utilisateur
LEADS_MAX_SEARCHES_PER_DAY=10
LEADS_MAX_MESSAGES_PER_DAY=200
